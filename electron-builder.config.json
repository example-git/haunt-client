{
  "appId": "com.exampleuser.haunt",
  "productName": "Haunt",
  "asar": {
    "smartUnpack": true
  },
  "npmRebuild": false,
  "toolsets": { "appimage": "1.0.3" },
  "publish": null,
  "protocols": [{ "name": "Haunt links", "schemes": ["haunt"] }],
  "directories": {
    "app": "electron-app",
    "buildResources": "static",
    "output": "release/builder"
  },
  "files": [
    "package.json",
    "update-runtime.json",
    "main.cjs",
    "apps/desktop/*.cjs",
    "apps/desktop/capture-picker.html",
    "apps/desktop/capture-picker.js",
    "apps/desktop/capture-picker.css",
    "dist/**/*",
    "resources/icon.png",
    "!node_modules/**/*"
  ],
  "mac": {
    "extraResources": [
      {
        "from": "release/native/mac/notification-replacement.node",
        "to": "native/mac/notification-replacement.node"
      },
      {
        "from": "static/mac",
        "to": "local-install",
        "filter": [
          "Install Haunt.command",
          "finish-update.sh",
          "commit-install.sh"
        ]
      },
      {
        "from": "static/native/mac",
        "to": "native/mac",
        "filter": [
          "SwiftCaptureWorker",
          "HauntMediaWorker",
          "manifest.json",
          "NOTICE.txt"
        ]
      }
    ],
    "binaries": [
      "Contents/Resources/native/mac/notification-replacement.node",
      "Contents/Resources/native/mac/SwiftCaptureWorker",
      "Contents/Resources/native/mac/HauntMediaWorker"
    ],
    "category": "public.app-category.social-networking",
    "icon": "static/icon.icns",
    "hardenedRuntime": true,
    "identity": null,
    "notarize": false,
    "entitlements": "electron-app/entitlements.mac.plist",
    "entitlementsInherit": "electron-app/entitlements.mac.inherit.plist",
    "artifactName": "Haunt-${version}-mac-${arch}.${ext}",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      }
    ],
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Haunt uses your microphone for voice calls.",
      "NSCameraUsageDescription": "Haunt uses your camera when you enable video in a call.",
      "NSScreenCaptureUsageDescription": "Haunt uses screen recording access to share the screen you select.",
      "NSAudioCaptureUsageDescription": "Haunt uses audio capture access when you share system audio.",
      "com.apple.security.device.audio-input": true,
      "com.apple.security.device.camera": true
    }
  },
  "dmg": {
    "sign": false,
    "contents": [
      { "x": 140, "y": 170 },
      { "x": 400, "y": 170, "type": "link", "path": "/Applications" },
      {
        "x": 140,
        "y": 320,
        "type": "file",
        "path": "static/mac/Install Haunt.command"
      },
      {
        "x": 400,
        "y": 320,
        "type": "file",
        "path": "static/mac/Installation.txt"
      }
    ],
    "window": { "width": 540, "height": 440 }
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "asar": true,
    "executableName": "haunt",
    "icon": "static/icon.ico"
  },
  "linux": {
    "extraResources": [
      {
        "from": "release/native/linux",
        "to": "native/linux",
        "filter": [
          "HauntAudioWorker",
          "HauntShortcutWorker",
          "HauntCaptureWorker",
          "HauntMediaWorker",
          "NOTICE.txt"
        ]
      }
    ],
    "target": [
      {
        "target": "AppImage"
      },
      {
        "target": "rpm"
      }
    ],
    "category": "Network",
    "executableName": "haunt",
    "icon": "static/icons",
    "artifactName": "Haunt-${version}-linux-${arch}.${ext}",
    "syncDesktopName": true,
    "desktop": {
      "entry": {
        "X-GNOME-UsesNotifications": "true"
      }
    }
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "Haunt-Setup-${version}-${arch}.${ext}"
  },
  "rpm": {
    "packageName": "haunt",
    "maintainer": "Haunt",
    "vendor": "Haunt",
    "synopsis": "Community messaging and calls",
    "afterInstall": "static/linux/rpm-after-install.sh",
    "afterRemove": "static/linux/rpm-after-remove.sh",
    "depends": [
      "gtk3",
      "libnotify",
      "nss",
      "libXScrnSaver",
      "libXtst",
      "xdg-utils",
      "at-spi2-core",
      "libuuid",
      "libsecret",
      "alsa-lib",
      "pulseaudio-libs",
      "mesa-libgbm"
    ],
    "fpm": [
      "--before-install",
      "static/linux/rpm-before-install.sh",
      "--rpm-posttrans",
      "static/linux/rpm-after-transaction.sh",
      "static/linux/package-type=/opt/Haunt/resources/package-type",
      "static/linux/haunt=/usr/bin/haunt",
      "static/linux/com.exampleuser.haunt.metainfo.xml=/usr/share/metainfo/com.exampleuser.haunt.metainfo.xml"
    ]
  }
}
